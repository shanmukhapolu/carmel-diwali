rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Authentication / authorization helpers
    // ------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return get(
        /databases/$(database)/documents/admins/$(request.auth.uid)
      ).data;
    }

    function enabledRole(role) {
      return signedIn()
        && adminProfile().status == "enabled"
        && adminProfile().role == role;
    }

    function isAdmin() {
      return enabledRole("admin");
    }


    // ------------------------------------------------------------------------
    // Volunteer registrations
    // ------------------------------------------------------------------------
    //
    // Public users can create a registration.
    // Only authorized administrators can read, update, or delete registrations.
    //

    match /registrations/{registrationId} {
      allow read: if isAdmin();

      allow create: if true;

      allow update, delete: if isAdmin();
    }


    // ------------------------------------------------------------------------
    // Event-day check-in / check-out
    // ------------------------------------------------------------------------
    //
    // Each check-in document is associated with a volunteer registration.
    // Restricted to authorized administrators.
    //

    match /checkins/{registrationId} {
      allow read, create, update, delete: if isAdmin();
    }


    // ------------------------------------------------------------------------
    // Check-in activity log
    // ------------------------------------------------------------------------
    //
    // Audit log of check-in and check-out events.
    // Restricted to authorized administrators.
    //

    match /checkinActivity/{activityId} {
      allow read, create, update, delete: if isAdmin();
    }


    // ------------------------------------------------------------------------
    // Registration guards
    // ------------------------------------------------------------------------
    //
    // Used to prevent duplicate registrations or other public-side race
    // conditions. Public creation/read behavior can be tightened further
    // depending on the exact guard implementation in app.js.
    //

    match /registrationGuards/{guardId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }


    // ------------------------------------------------------------------------
    // Shift capacity counters
    // ------------------------------------------------------------------------
    //
    // Public users need to read shift availability.
    //
    // The frontend may create/update counters during registration.
    // Admins retain full control.
    //
    // IMPORTANT:
    // The exact write validation should be tightened once the final
    // registration/shift transaction logic is confirmed.
    //

    match /shiftCounts/{shiftDocId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }


    // ------------------------------------------------------------------------
    // Event settings
    // ------------------------------------------------------------------------
    //
    // Public users can read settings needed to display the event.
    // Only administrators can modify them.
    //

    match /eventSettings/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ------------------------------------------------------------------------
    // Volunteer/admin accounts
    // ------------------------------------------------------------------------
    //
    // A user may create their own disabled "none" profile.
    // Only administrators can enable roles or modify/delete profiles.
    //

    match /admins/{adminId} {
      allow read: if signedIn()
        && (adminId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && adminId == request.auth.uid
        && request.resource.data.role == "none"
        && request.resource.data.status == "disabled";

      allow update, delete: if isAdmin();
    }


    // ------------------------------------------------------------------------
    // Catch-all
    // ------------------------------------------------------------------------
    //
    // Administrators can access documents not covered above.
    //

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}