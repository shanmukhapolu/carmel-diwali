rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // AUTHENTICATION / ADMIN
    // ========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return get(
        /databases/$(database)/documents/admins/$(request.auth.uid)
      ).data;
    }

    function enabledRole(role) {
      return signedIn()
        && adminProfile().status == "enabled"
        && adminProfile().role == role;
    }

    function isAdmin() {
      return enabledRole("admin");
    }


    // ========================================================================
    // VOLUNTEER REGISTRATIONS
    // ========================================================================

    match /registrations/{registrationId} {

      // Volunteers' actual registration records remain private.
      allow read: if isAdmin();

      // Public registration creation.
      allow create: if request.auth == null;

      // Administrators can modify registrations normally.
      //
      // Public users may ONLY cancel an existing active registration.
      allow update: if isAdmin()
        || (
          request.auth == null

          && resource.data.eventId ==
             "carmel-diwali-2026"

          && resource.data.status ==
             "registered"

          && request.resource.data.status ==
             "cancelled"

          && request.resource.data.manageLookupId is string

          && request.resource.data.manageLookupId ==
             resource.data.manageLookupId

          && request.resource.data.diff(
               resource.data
             ).affectedKeys()
             .hasOnly([
               "status",
               "cancelledAt"
             ])

          && request.resource.data.cancelledAt
             is timestamp
        );

      allow delete: if isAdmin();
    }


    // ========================================================================
    // PUBLIC MANAGE REGISTRATION LOOKUPS
    // ========================================================================
    //
    // The public Manage page reads these documents instead of the private
    // registrations collection.
    //
    // lookupId:
    //   SHA-256(eventId + "|" + normalizedLastName + "|" + normalizedPhone)
    //
    // These records contain only management information.
    //
    // IMPORTANT:
    // Last name + phone is the management credential requested for this app.
    // It is not equivalent to authenticated user accounts.
    //

    match /registrationLookups/{lookupId} {

      allow read: if request.auth == null
        || isAdmin();

      // First registration creates the lookup document.
      allow create: if request.auth == null
        && request.resource.data.eventId ==
           "carmel-diwali-2026"

        && request.resource.data.normalizedLastName
           is string

        && request.resource.data.entries
           is list

        && request.resource.data.registrationIds
           is list;

      // Public Manage/sign-up flows may update only the management
      // information contained inside an existing event lookup.
      allow update: if request.auth == null
        && resource.data.eventId ==
           "carmel-diwali-2026"

        && request.resource.data.eventId ==
           resource.data.eventId

        && request.resource.data.normalizedLastName ==
           resource.data.normalizedLastName

        && request.resource.data.entries
           is list

        && request.resource.data.registrationIds
           is list

        && request.resource.data.diff(
             resource.data
           ).affectedKeys()
           .hasOnly([
             "entries",
             "registrationIds",
             "updatedAt"
           ]);

      allow delete: if isAdmin();
    }


    // ========================================================================
    // REGISTRATION DUPLICATE GUARDS
    // ========================================================================

    match /registrationGuards/{guardId} {

      allow read: if request.auth == null
        || isAdmin();

      allow create: if request.auth == null
        || isAdmin();

      // Public users can only change an active guard to cancelled.
      allow update: if isAdmin()
        || (
          request.auth == null

          && resource.data.status ==
             "active"

          && request.resource.data.status ==
             "cancelled"

          && request.resource.data.registrationId ==
             resource.data.registrationId

          && request.resource.data.diff(
               resource.data
             ).affectedKeys()
             .hasOnly([
               "status",
               "cancelledAt"
             ])

          && request.resource.data.cancelledAt
             is timestamp
        );

      allow delete: if isAdmin();
    }


    // ========================================================================
    // SHIFT COUNTERS
    // ========================================================================

    match /shiftCounts/{shiftDocId} {

      allow read: if request.auth == null
        || isAdmin();

      // First registration for a shift.
      allow create: if isAdmin()
        || (
          request.auth == null

          && request.resource.data.eventId ==
             "carmel-diwali-2026"

          && request.resource.data.count ==
             1

          && request.resource.data.count
             is number

          && request.resource.data.capacity
             is number

          && request.resource.data.count >= 0

          && request.resource.data.count <=
             request.resource.data.capacity
        );

      // Public users may change a counter by exactly one:
      //
      // +1 = registration/add-shift
      // -1 = cancellation
      //
      // Counter can never become negative or exceed capacity.
      allow update: if isAdmin()
        || (
          request.auth == null

          && resource.data.eventId ==
             "carmel-diwali-2026"

          && request.resource.data.eventId ==
             resource.data.eventId

          && request.resource.data.capacity ==
             resource.data.capacity

          && resource.data.count
             is number

          && request.resource.data.count
             is number

          && (
            request.resource.data.count ==
              resource.data.count + 1

            || request.resource.data.count ==
              resource.data.count - 1
          )

          && request.resource.data.count >= 0

          && request.resource.data.count <=
             request.resource.data.capacity
        );

      allow delete: if isAdmin();
    }


    // ========================================================================
    // EVENT SETTINGS
    // ========================================================================

    match /eventSettings/{eventId} {

      allow read: if request.auth == null
        || isAdmin();

      allow write: if isAdmin();
    }


    // ========================================================================
    // CHECK-IN
    // ========================================================================

    match /checkins/{registrationId} {
      allow read,
            create,
            update,
            delete: if isAdmin();
    }


    match /checkinActivity/{activityId} {
      allow read,
            create,
            update,
            delete: if isAdmin();
    }


    // ========================================================================
    // ADMIN ACCOUNTS
    // ========================================================================

    match /admins/{adminId} {

      allow read: if signedIn()
        && (
          adminId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && adminId == request.auth.uid
        && request.resource.data.role ==
           "none"
        && request.resource.data.status ==
           "disabled";

      allow update,
            delete: if isAdmin();
    }


    // ========================================================================
    // CATCH-ALL
    // ========================================================================

    match /{document=**} {
      allow read,
            write: if isAdmin();
    }
  }
}