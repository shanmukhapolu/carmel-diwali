rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // AUTHENTICATION / ADMIN
    // ========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return get(
        /databases/$(database)/documents/admins/$(request.auth.uid)
      ).data;
    }

    function enabledRole(role) {
      return signedIn()
        && adminProfile().status == "enabled"
        && adminProfile().role == role;
    }

    function isAdmin() {
      return enabledRole("admin");
    }


    // ========================================================================
    // VOLUNTEER REGISTRATIONS
    // ========================================================================

    match /registrations/{registrationId} {

      // Actual registration records are private.
      allow read: if isAdmin();

      // Public users may create new registrations.
      allow create: if request.auth == null;

      // Only administrators may directly modify registrations.
      allow update: if isAdmin();

      // Public Manage cancellation.
      //
      // The registration may only be deleted when:
      // - it belongs to this event
      // - it is currently registered
      // - it has a valid management lookup
      // - that lookup currently references this registration
      //
      // This prevents arbitrary deletion of unrelated registration records.
      allow delete: if isAdmin()
        || (
          request.auth == null

          && resource.data.eventId ==
             "carmel-diwali-2026"

          && resource.data.status ==
             "registered"

          && resource.data.manageLookupId is string

          && get(
               /databases/$(database)/documents/registrationLookups/$(resource.data.manageLookupId)
             ).data.eventId ==
             "carmel-diwali-2026"

          && get(
               /databases/$(database)/documents/registrationLookups/$(resource.data.manageLookupId)
             ).data.registrationIds
             .hasAny([registrationId])
        );
    }


    // ========================================================================
    // PUBLIC MANAGE REGISTRATION LOOKUPS
    // ========================================================================

    match /registrationLookups/{lookupId} {

      // The public Manage page needs to read these.
      allow read: if request.auth == null
        || isAdmin();

      // First registration creates the lookup document.
      allow create: if request.auth == null
        && request.resource.data.eventId ==
           "carmel-diwali-2026"

        && request.resource.data.normalizedLastName
           is string

        && request.resource.data.entries
           is list

        && request.resource.data.registrationIds
           is list;

      // Public registration and Manage flows may update only the
      // registration-management fields.
      allow update: if request.auth == null
        && resource.data.eventId ==
           "carmel-diwali-2026"

        && request.resource.data.eventId ==
           resource.data.eventId

        && request.resource.data.normalizedLastName ==
           resource.data.normalizedLastName

        && request.resource.data.entries
           is list

        && request.resource.data.registrationIds
           is list

        && request.resource.data.diff(
             resource.data
           ).affectedKeys()
           .hasOnly([
             "entries",
             "registrationIds",
             "updatedAt"
           ]);

      // Lookup documents cannot be physically deleted publicly.
      allow delete: if isAdmin();
    }


    // ========================================================================
    // REGISTRATION DUPLICATE GUARDS
    // ========================================================================

    match /registrationGuards/{guardId} {

      // Needed by the public registration transaction to check guards.
      allow read: if request.auth == null
        || isAdmin();

      // Public registration flow may create guards.
      allow create: if request.auth == null
        || isAdmin();

      // The current system uses physical deletion for cancellation.
      // Only administrators may otherwise modify a guard.
      allow update: if isAdmin();

      // Public Manage cancellation may delete an active guard only when
      // that guard points to an active registration belonging to this event.
      //
      // NOTE: Guards do not need their own eventId field.
      allow delete: if isAdmin()
        || (
          request.auth == null

          && resource.data.status ==
             "active"

          && resource.data.registrationId is string

          && get(
               /databases/$(database)/documents/registrations/$(resource.data.registrationId)
             ).data.eventId ==
             "carmel-diwali-2026"

          && get(
               /databases/$(database)/documents/registrations/$(resource.data.registrationId)
             ).data.status ==
             "registered"
        );
    }


    // ========================================================================
    // SHIFT COUNTERS
    // ========================================================================

    match /shiftCounts/{shiftDocId} {

      // Public registration UI needs current availability.
      allow read: if request.auth == null
        || isAdmin();

      // First registration for a shift.
      allow create: if isAdmin()
        || (
          request.auth == null

          && request.resource.data.eventId ==
             "carmel-diwali-2026"

          && request.resource.data.count ==
             1

          && request.resource.data.count
             is number

          && request.resource.data.capacity
             is number

          && request.resource.data.count >= 0

          && request.resource.data.count <=
             request.resource.data.capacity
        );

      // Public registration/add-shift = +1.
      // Public cancellation = -1.
      allow update: if isAdmin()
        || (
          request.auth == null

          && resource.data.eventId ==
             "carmel-diwali-2026"

          && request.resource.data.eventId ==
             resource.data.eventId

          && request.resource.data.capacity ==
             resource.data.capacity

          && resource.data.count
             is number

          && request.resource.data.count
             is number

          && (
            request.resource.data.count ==
              resource.data.count + 1

            || request.resource.data.count ==
              resource.data.count - 1
          )

          && request.resource.data.count >= 0

          && request.resource.data.count <=
             request.resource.data.capacity
        );

      allow delete: if isAdmin();
    }


    // ========================================================================
    // EVENT SETTINGS
    // ========================================================================

    match /eventSettings/{eventId} {

      allow read: if request.auth == null
        || isAdmin();

      allow write: if isAdmin();
    }


    // ========================================================================
    // CHECK-IN
    // ========================================================================

    match /checkins/{registrationId} {
      allow read,
            create,
            update,
            delete: if isAdmin();
    }

    match /checkinActivity/{activityId} {
      allow read,
            create,
            update,
            delete: if isAdmin();
    }


    // ========================================================================
    // ADMIN ACCOUNTS
    // ========================================================================

    match /admins/{adminId} {

      allow read: if signedIn()
        && (
          adminId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && adminId == request.auth.uid
        && request.resource.data.role ==
           "none"
        && request.resource.data.status ==
           "disabled";

      allow update,
            delete: if isAdmin();
    }


    // ========================================================================
    // CATCH-ALL
    // ========================================================================

    match /{document=**} {
      allow read,
            write: if isAdmin();
    }
  }
}