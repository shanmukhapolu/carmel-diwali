rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // AUTHENTICATION / ADMIN
    // ========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return get(
        /databases/$(database)/documents/admins/$(request.auth.uid)
      ).data;
    }

    function enabledRole(role) {
      return signedIn()
        && adminProfile().status == "enabled"
        && adminProfile().role == role;
    }

    function isAdmin() {
      return enabledRole("admin");
    }

    function isCheckinStaff() {
      return enabledRole("checkin");
    }

    function canCheckIn() {
      return isAdmin() || isCheckinStaff();
    }

    function registrationIsForEvent(registrationId) {
      return exists(
          /databases/$(database)/documents/registrations/$(registrationId)
        )
        && get(
          /databases/$(database)/documents/registrations/$(registrationId)
        ).data.eventId == "carmel-diwali-2026";
    }


    // ========================================================================
    // VOLUNTEER REGISTRATIONS
    // ========================================================================

    match /registrations/{registrationId} {

      // Registration data is readable by admins and check-in staff only.
      allow read: if canCheckIn();

      // Public users may create new registrations.
      allow create: if request.auth == null;

      // Only administrators may directly modify registrations.
      allow update: if isAdmin();

      // Public Manage cancellation.
      //
      // The registration may only be deleted when:
      // - it belongs to this event
      // - it is currently registered
      // - it has a valid management lookup
      // - that lookup currently references this registration
      //
      // This prevents arbitrary deletion of unrelated registration records.
      allow delete: if isAdmin()
        || (
          request.auth == null

          && resource.data.eventId ==
             "carmel-diwali-2026"

          && resource.data.status ==
             "registered"

          && resource.data.manageLookupId is string

          && get(
               /databases/$(database)/documents/registrationLookups/$(resource.data.manageLookupId)
             ).data.eventId ==
             "carmel-diwali-2026"

          && get(
               /databases/$(database)/documents/registrationLookups/$(resource.data.manageLookupId)
             ).data.registrationIds
             .hasAny([registrationId])
        );
    }


    // ========================================================================
    // PUBLIC MANAGE REGISTRATION LOOKUPS
    // ========================================================================

    match /registrationLookups/{lookupId} {

      // The public Manage page needs to read these.
      allow read: if request.auth == null
        || isAdmin();

      // First registration creates the lookup document.
      allow create: if request.auth == null
        && request.resource.data.eventId ==
           "carmel-diwali-2026"

        && request.resource.data.normalizedLastName
           is string

        && request.resource.data.entries
           is list

        && request.resource.data.registrationIds
           is list;

      // Public registration and Manage flows may update only the
      // registration-management fields.
      allow update: if request.auth == null
        && resource.data.eventId ==
           "carmel-diwali-2026"

        && request.resource.data.eventId ==
           resource.data.eventId

        && request.resource.data.normalizedLastName ==
           resource.data.normalizedLastName

        && request.resource.data.entries
           is list

        && request.resource.data.registrationIds
           is list

        && request.resource.data.diff(
             resource.data
           ).affectedKeys()
           .hasOnly([
             "entries",
             "registrationIds",
             "updatedAt"
           ]);

      // Lookup documents cannot be physically deleted publicly.
      allow delete: if isAdmin();
    }


    // ========================================================================
    // REGISTRATION DUPLICATE GUARDS
    // ========================================================================

    match /registrationGuards/{guardId} {

      // Needed by the public registration transaction to check guards.
      allow read: if request.auth == null
        || isAdmin();

      // Public registration flow may create guards.
      allow create: if request.auth == null
        || isAdmin();

      // The current system uses physical deletion for cancellation.
      // Only administrators may otherwise modify a guard.
      allow update: if isAdmin();

      // Public Manage cancellation may delete an active guard only when
      // that guard points to an active registration belonging to this event.
      //
      // NOTE: Guards do not need their own eventId field.
      allow delete: if isAdmin()
        || (
          request.auth == null

          && resource.data.status ==
             "active"

          && resource.data.registrationId is string

          && get(
               /databases/$(database)/documents/registrations/$(resource.data.registrationId)
             ).data.eventId ==
             "carmel-diwali-2026"

          && get(
               /databases/$(database)/documents/registrations/$(resource.data.registrationId)
             ).data.status ==
             "registered"
        );
    }


    // ========================================================================
    // SHIFT COUNTERS
    // ========================================================================

    match /shiftCounts/{shiftDocId} {

      // Public registration UI needs current availability.
      allow read: if request.auth == null
        || isAdmin();

      // First registration for a shift.
      allow create: if isAdmin()
        || (
          request.auth == null

          && request.resource.data.eventId ==
             "carmel-diwali-2026"

          && request.resource.data.count ==
             1

          && request.resource.data.count
             is number

          && request.resource.data.capacity
             is number

          && request.resource.data.count >= 0

          && request.resource.data.count <=
             request.resource.data.capacity
        );

      // Public registration/add-shift = +1.
      // Public cancellation = -1.
      allow update: if isAdmin()
        || (
          request.auth == null

          && resource.data.eventId ==
             "carmel-diwali-2026"

          && request.resource.data.eventId ==
             resource.data.eventId

          && request.resource.data.capacity ==
             resource.data.capacity

          && resource.data.count
             is number

          && request.resource.data.count
             is number

          && (
            request.resource.data.count ==
              resource.data.count + 1

            || request.resource.data.count ==
              resource.data.count - 1
          )

          && request.resource.data.count >= 0

          && request.resource.data.count <=
             request.resource.data.capacity
        );

      allow delete: if isAdmin();
    }


    // ========================================================================
    // EVENT SETTINGS
    // ========================================================================

    match /eventSettings/{eventId} {

      allow read: if request.auth == null
        || isAdmin();

      allow write: if isAdmin();
    }


    // ========================================================================
    // CHECK-IN
    // ========================================================================

    match /checkins/{registrationId} {
      // Check-in staff can read attendance status, but cannot delete records.
      allow read: if canCheckIn();

      // A check-in staff account can create only a valid check-in or late
      // record for a registration belonging to this event.
      allow create: if isAdmin()
        || (
          isCheckinStaff()
          && registrationIsForEvent(registrationId)
          && request.resource.data.registrationId == registrationId
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedByName is string
          && request.resource.data.updatedAt is timestamp
          && (
            (
              request.resource.data.status == "checked_in"
              && request.resource.data.keys().hasAll([
                "registrationId",
                "status",
                "updatedAt",
                "updatedBy",
                "updatedByName",
                "checkedInAt",
                "checkedInBy",
                "checkedInByName"
              ])
              && request.resource.data.keys().hasOnly([
                "registrationId",
                "status",
                "updatedAt",
                "updatedBy",
                "updatedByName",
                "checkedInAt",
                "checkedInBy",
                "checkedInByName"
              ])
              && request.resource.data.checkedInAt is timestamp
              && request.resource.data.checkedInBy == request.auth.uid
              && request.resource.data.checkedInByName is string
            )
            ||
            (
              request.resource.data.status == "late"
              && request.resource.data.keys().hasAll([
                "registrationId",
                "status",
                "lateAt",
                "updatedAt",
                "updatedBy",
                "updatedByName"
              ])
              && request.resource.data.keys().hasOnly([
                "registrationId",
                "status",
                "lateAt",
                "updatedAt",
                "updatedBy",
                "updatedByName"
              ])
              && request.resource.data.lateAt is timestamp
            )
          )
        );

      // Updates are limited to the valid state changes:
      // late/registered -> checked_in, checked_in -> completed, and
      // registered -> late. The transaction in the client enforces the
      // same transitions to prevent two devices acting on stale state.
      allow update: if isAdmin()
        || (
          isCheckinStaff()
          && registrationIsForEvent(registrationId)
          && request.resource.data.registrationId == registrationId
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedByName is string
          && request.resource.data.updatedAt is timestamp
          && (
            (
              resource.data.status in ["registered", "late"]
              && request.resource.data.status == "checked_in"
              && request.resource.data.checkedInAt is timestamp
              && request.resource.data.checkedInBy == request.auth.uid
              && request.resource.data.checkedInByName is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "updatedAt",
                "updatedBy",
                "updatedByName",
                "checkedInAt",
                "checkedInBy",
                "checkedInByName"
              ])
            )
            ||
            (
              resource.data.status == "checked_in"
              && request.resource.data.status == "completed"
              && request.resource.data.checkedOutAt is timestamp
              && request.resource.data.checkedOutBy == request.auth.uid
              && request.resource.data.checkedOutByName is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "updatedAt",
                "updatedBy",
                "updatedByName",
                "checkedOutAt",
                "checkedOutBy",
                "checkedOutByName"
              ])
            )
            ||
            (
              resource.data.status == "registered"
              && request.resource.data.status == "late"
              && request.resource.data.lateAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "lateAt",
                "updatedAt",
                "updatedBy",
                "updatedByName"
              ])
            )
          )
        );

      // Check-in staff may not delete attendance records.
      allow delete: if isAdmin();
    }

    match /checkinActivity/{activityId} {
      allow read: if canCheckIn();

      // Activity documents are append-only for check-in staff.
      allow create: if isAdmin()
        || (
          isCheckinStaff()
          && request.resource.data.keys().hasAll([
            "registrationId",
            "action",
            "actorUid",
            "actorName",
            "occurredAt"
          ])
          && request.resource.data.keys().hasOnly([
            "registrationId",
            "action",
            "actorUid",
            "actorName",
            "occurredAt"
          ])
          && request.resource.data.registrationId is string
          && registrationIsForEvent(request.resource.data.registrationId)
          && request.resource.data.action in ["checkin", "checkout", "late"]
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.occurredAt is timestamp
        );

      allow update,
            delete: if isAdmin();
    }


    // ========================================================================
    // WHATSAPP CONTACT MANAGEMENT
    // ========================================================================

    // WhatsApp group status is administrative metadata and is never
    // readable or writable by public users.
    match /whatsappContacts/{normalizedPhone} {
      allow read: if isAdmin();

      allow create,
            update: if isAdmin()
        && request.resource.data.eventId ==
           "carmel-diwali-2026"
        && request.resource.data.normalizedPhone ==
           normalizedPhone
        && request.resource.data.status in [
             "joined",
             "invited",
             "not_valid",
             "not_joined"
           ];

      allow delete: if isAdmin();
    }


    // ========================================================================
    // ADMIN ACCOUNTS
    // ========================================================================

    match /admins/{adminId} {

      allow read: if signedIn()
        && (
          adminId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && adminId == request.auth.uid
        && request.resource.data.role ==
           "none"
        && request.resource.data.status ==
           "disabled";

      allow update,
            delete: if isAdmin();
    }


    // ========================================================================
    // CATCH-ALL
    // ========================================================================

    match /{document=**} {
      allow read,
            write: if isAdmin();
    }
  }
}